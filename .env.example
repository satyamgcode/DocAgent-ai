# Default Provider: gemini, openai, claude, or generic
DEFAULT_PROVIDER=gemini

# Google Gemini API Key (from https://aistudio.google.com/)
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=models/gemini-2.0-flash

# OpenAI API Key (from https://platform.openai.com/api-keys)
OPENAI_API_KEY=your_openai_api_key_here
OPENAI_MODEL=gpt-4o-mini
# OPENAI_BASE_URL=https://api.openai.com/v1

# Anthropic Claude API Key (from https://console.anthropic.com/)
ANTHROPIC_API_KEY=your_claude_api_key_here
# CLAUDE_API_KEY is also accepted as an alias
CLAUDE_MODEL=claude-3-5-haiku-20241022

# Generic / Custom OpenAI-Compatible Provider (Groq, OpenRouter, DeepSeek, Ollama, LM Studio, etc.)
GENERIC_API_KEY=your_generic_or_groq_or_openrouter_key_here
GENERIC_BASE_URL=https://api.groq.com/openai/v1
GENERIC_MODEL=llama-3.3-70b-versatile

# checkout
